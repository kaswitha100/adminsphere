PORT=5000
NODE_ENV=production
# In production, specify your MongoDB Atlas connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/adminsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/adminsphere?retryWrites=true&w=majority
JWT_SECRET=adminsphere_super_secure_production_jwt_secret_replace_me
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-adminsphere-frontend.vercel.app
